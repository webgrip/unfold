        "labels": "apps/unfold/public/core/states.js `workItemStates`; the stage strip from apps/unfold/public/core/stages.js `workStages`, without a Run card"
      },
      "mcp": "passes Unfold's state through as `state` in unfold_now, unfold_find_work and unfold_get_work; unfold_find_work's `state` filter accepts both `active` and `leased`",
      "values": [
        {
          "value": "ingested",
          "label": "Received",
          "stage": "Define",
          "mcp": "ingested"
        },
        {
          "value": "proposed",
          "label": "Proposed",
          "stage": "Define",
          "mcp": "proposed"
        },
        {
          "value": "queued",
          "label": "Queued",
          "stage": "Execute",
          "mcp": "queued"
        },
        {
          "value": "leased",
          "label": "Running",
          "stage": "Execute",
          "mcp": "leased",
          "deprecated": "Ploeg renames it `active` (system ADR-0036). Until every Ploeg Unfold talks to sends `active`, Unfold accepts both and keeps `leased` as its own name."
