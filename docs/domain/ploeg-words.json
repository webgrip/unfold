        },
        {
          "value": "awaiting_review",
          "label": "Ready for review",
          "heading": "Ready for your review",
          "stage": "Review",
          "mcp": "awaiting_review"
        },
        {
          "value": "stale",
          "label": "Stopped retrying",
          "stage": "Execute (stopped)",
          "mcp": "stale"
        },
        {
          "value": "done",
          "label": "Done",
          "stage": "none: finished",
          "mcp": "done"
        },
        {
          "value": "withdrawn",
          "label": "Withdrawn",
          "stage": "Execute (stopped)",
          "mcp": "withdrawn"
        },
