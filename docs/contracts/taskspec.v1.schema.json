{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webgrip.dev/ploeg/contracts/taskspec.v1.schema.json",
  "title": "TaskSpec",
  "description": "The harness contract input (design §5, harness.TaskSpec): everything a run needs to know about the work, the repo, and its identity. Credentials are delivered out-of-band (env, mounted secrets), never here (R8).",
  "type": "object",
  "properties": {
    "workItem": { "$ref": "#/$defs/workItem" },
    "role": { "type": "string", "description": "specialist role within the team" },
    "checkpoint": { "$ref": "checkpoint.v1.schema.json" },
    "repo": {
      "type": "object",
      "properties": {
        "forgeUrl": { "type": "string", "description": "forge base URL" },
        "owner": { "type": "string" },
        "name": { "type": "string" },
        "baseBranch": {
          "type": "string",
          "description": "branch to clone/branch from and open the PR against; absent = repo default branch (VIK-589)"
        }
      },
      "required": ["forgeUrl", "owner", "name"],
      "additionalProperties": false
    },
    "branch": { "type": "string", "description": "work branch, e.g. agent/vik-<id>" },
    "traceId": {
      "type": "string",
      "pattern": "^ploeg-[0-9a-f]{12}$",
      "description": "run trace id; doubles as the LiteLLM key alias Grafana joins on"
    },
    "briefing": { "$ref": "#/$defs/briefing" }
  },
  "required": ["workItem", "repo", "branch", "traceId"],
  "additionalProperties": false,
  "$defs": {
    "briefing": {
      "type": "array",
      "description": "Earlier Rounds' findings, attributed per Role (ADR-0011). Ploeg injects them; the agent never fetches them itself (R6).",
      "items": {
        "type": "object",
        "properties": {
          "role": { "type": "string" },
          "round": { "type": "integer", "minimum": 0 },
          "findings": { "type": "string" }
        },
        "required": ["role", "round", "findings"],
        "additionalProperties": false
      }
    },
    "workItem": {
      "type": "object",
      "description": "Mirror of one tracker item (work.WorkItem).",
      "properties": {
        "id": { "type": "string" },
        "provider": { "type": "string" },
        "externalId": { "type": "string" },
        "revision": { "type": "string" },
        "team": { "type": "string" },
        "state": {
          "type": "string",
          "enum": ["ingested", "queued", "leased", "needs_human", "stale", "done"]
        },
        "origin": { "type": "string", "enum": ["assignment", "follow_up"] },
        "priority": { "type": "integer" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "externalScope": {
          "type": "string",
          "description": "the tracker's own container for this item (Vikunja project id); the input to Work Target resolution"
        },
        "target": {
          "type": "object",
          "description": "where this item's changes land. Belongs to the work item, never to the team (R11). Absent = unresolved; the worker falls back to its configured repo. Harness authors should read the top-level `repo`, which is the EFFECTIVE target for the run.",
          "properties": {
            "forge": { "type": "string", "description": "forge registry id; absent = the default forge" },
            "owner": { "type": "string" },
            "repo": { "type": "string" },
            "baseBranch": { "type": "string" }
          },
          "required": ["owner", "repo"],
          "additionalProperties": false
        },
        "routeRule": {
          "type": "string",
          "description": "id of the routing rule that decided team and target, for audit"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "provider", "externalId"],
      "additionalProperties": false
    }
  }
}
