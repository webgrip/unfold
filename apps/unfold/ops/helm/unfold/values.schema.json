{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "mode": { "enum": ["demo", "live"] },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "description": "Local name-and-password sign-in. localLogin false offers only single sign-on (config.auth.oidc required), refuses POST /api/login, creates no bootstrap administrator and rejects sessions of local accounts.",
      "properties": { "localLogin": { "type": "boolean" } },
      "required": ["localLogin"]
    },
    "decider": {
      "type": "object",
      "additionalProperties": false,
      "description": "The decider the tripwire asks (RFC-0008). Off unless enabled; live mode only.",
      "properties": {
        "enabled": { "type": "boolean" },
        "baseUrl": { "type": "string", "pattern": "^(https?://.+)?$" },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,127}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "keyEnv": { "type": "string", "pattern": "^UNFOLD_[A-Z0-9_]{1,100}$" },
        "requestsPerMinute": { "type": "integer", "minimum": 1, "maximum": 60 },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "extraEnv": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string", "minLength": 1 } }, "required": ["name"] } },
    "insight": { "type": "object", "additionalProperties": false, "properties": { "events": { "type": "boolean" }, "export": { "type": "string", "enum": ["off", "faro", "otlp"] }, "url": { "type": "string", "pattern": "^(https?://.+)?$" }, "level": { "type": "string", "enum": ["aggregate", "events"] } } },
    "errorReports": { "type": "object", "additionalProperties": false, "properties": { "environment": { "type": "string", "pattern": "^([A-Za-z0-9_.-]{1,64})?$" }, "otlpUrl": { "type": "string", "pattern": "^(https?://.+)?$" }, "sentry": { "type": "object", "additionalProperties": false, "properties": { "existingSecret": { "type": "string" }, "secretKey": { "type": "string", "minLength": 1 } } } } },
    "ploegMcp": { "type": "object", "additionalProperties": false, "properties": { "url": { "type": "string", "pattern": "^(https://[^\\s?#]+)?$" }, "clientId": { "type": "string", "pattern": "^([A-Za-z0-9._:-]{1,200})?$" } } },
    "workspaceNamespace": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
    "createWorkspaceNamespace": { "type": "boolean" },
    "workspaceImage": { "type": "string" },
    "workspaceAgentImage": { "type": "object", "additionalProperties": false, "required": ["repository", "tag", "digest"], "properties": { "repository": { "type": "string", "minLength": 1 }, "tag": { "type": "string" }, "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" } } },
    "workspaceStorageSize": { "type": "string", "minLength": 1 },
    "workspaceStorageClass": { "type": "string" },
    "workspaceCpu": { "type": "string", "minLength": 1 },
    "workspaceMemory": { "type": "string", "minLength": 1 },
    "workspaceCpuRequest": { "type": "string" },
    "workspaceMemoryRequest": { "type": "string" },
    "workspaceEgress": { "type": "array", "items": { "type": "object" } },
    "workspaceImagePullSecrets": { "type": "array", "items": { "type": "string" } },
    "workspaceGitSecretName": { "type": "string" },
    "workspaceGitRewrites": { "type": "array", "maxItems": 16, "items": { "type": "object", "additionalProperties": false, "required": ["url", "insteadOf"], "properties": { "url": { "type": "string", "pattern": "^https?://[^\\s@?#]+/$" }, "insteadOf": { "type": "string", "pattern": "^https?://[^\\s@?#]+/$" } } } },
    "workspaceTransport": { "enum": ["publish", "pull"] },
    "workspaceRelayUrl": { "type": "string" },
    "workspaceProvisioner": { "enum": ["pod", "sandbox"] },
    "workspaceRuntimeClassName": { "type": "string" },
    "workspaceWarmPool": { "type": "string" },
    "workspaceUserNamespaces": { "type": "boolean" },
    "workspacePodRuntimeClassName": { "type": "string", "pattern": "^([A-Za-z0-9_.-]{1,253})?$" },
    "workspaceRetentionDays": { "type": "integer", "minimum": 0, "maximum": 365 },
    "workspaceVolumeDeleteAnnotations": { "type": "object", "maxProperties": 8, "additionalProperties": { "type": "string" } },
    "workspaceAgentSecrets": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" } },
    "credentialsSecret": { "type": "string", "minLength": 1 },
    "storeKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "delivery": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "verifierTokenEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,100}$"}, "policies": {"type": "array", "items": {"type": "object"}}, "inputs": {"type": "object", "additionalProperties": false, "properties": {"mountPath": {"type": "string", "pattern": "^/[^\\s]*$"}, "volume": {"type": "object"}}}, "publisher": {"type": "object", "additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "apiUrl": {"type": "string", "pattern": "^(https://.+)?$"}, "username": {"type": "string"}, "tokenEnv": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,100}$"}, "existingSecret": {"type": "string"}, "secretKey": {"type": "string", "minLength": 1}}}, "verifier": {"type": "object", "additionalProperties": false, "properties": {"namespace": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"}, "createNamespace": {"type": "boolean"}, "runtimeClassName": {"type": "string", "minLength": 1}, "image": {"type": "string", "pattern": "^$|^[a-zA-Z0-9._:/-]+@sha256:[a-f0-9]{64}$"}, "resources": {"type": "object", "additionalProperties": false, "required": ["requests", "limits"], "properties": {"requests": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi)?$"}, "memory": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi)?$"}}}, "limits": {"type": "object", "additionalProperties": false, "required": ["cpu", "memory"], "properties": {"cpu": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi)?$"}, "memory": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|Ki|Mi|Gi)?$"}}}}}, "timeoutSeconds": {"type": "integer", "minimum": 31, "maximum": 3600}, "networkProbe": {"type": "object", "additionalProperties": false, "properties": {"host": {"type": "string"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}, "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}}, "affinity": {"type": "object"}, "tolerations": {"type": "array", "items": {"type": "object"}}, "imagePullSecrets": {"type": "array", "items": {"type": "string"}}}}}},
    "featureFlags": { "type": "object", "additionalProperties": false, "properties": { "$schema": { "type": "string" }, "metadata": { "type": "object" }, "flags": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": false, "properties": { "state": { "enum": ["ENABLED", "DISABLED"] }, "variants": { "type": "object" }, "defaultVariant": { "type": "string" }, "targeting": { "type": "object" } } } }, "$evaluators": { "type": "object" } } },
    "config": {
      "type": "object",
      "properties": {
        "teams": { "type": "array", "items": { "type": "object" }, "description": "The Teams sessions run with: each {id, name, description, roles}. Unset means Unfold's default Teams." },
        "crews": { "type": "array", "items": { "type": "object" }, "deprecated": true, "description": "Deprecated name of config.teams (system ADR-0036). Still read; set teams instead. Setting both with different lists stops Unfold from starting." },
        "ploeg": {
          "type": "object",
          "properties": {
            "personTokens": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tokenUrl", "clientId", "clientSecretEnv", "audience"],
              "description": "Optional. Exchange each person's sign-in token for a Ploeg-audience token and send it with every change Unfold makes for them (Unfold ADR 0055). Off when absent.",
              "properties": {
                "tokenUrl": { "type": "string", "pattern": "^https?://[^\\s#]+$" },
                "clientId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,200}$" },
                "clientSecretEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
                "audience": { "type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,200}$" }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "host": { "type": "string" }, "className": { "type": "string" }, "tlsSecret": { "type": "string" } }
    },
    "ploeg": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "required": ["enabled"]
    }
  },
  "required": ["mode", "workspaceNamespace", "credentialsSecret"]
}
