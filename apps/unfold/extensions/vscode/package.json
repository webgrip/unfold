{
  "name": "unfold",
  "displayName": "Unfold — Remote Agent Workbench",
  "description": "Steer agent work from VS Code: review evidence and control sessions on your machine or a remote workbench.",
  "version": "0.4.0-rc.45",
  "publisher": "webgrip",
  "license": "Apache-2.0",
  "homepage": "https://forgejo.webgrip.dev/webgrip/unfold/src/branch/development/apps/unfold/extensions/vscode",
  "repository": {
    "type": "git",
    "url": "https://forgejo.webgrip.dev/webgrip/unfold.git",
    "directory": "apps/unfold/extensions/vscode"
  },
  "bugs": {
    "url": "https://forgejo.webgrip.dev/webgrip/unfold/issues"
  },
  "qna": "https://forgejo.webgrip.dev/webgrip/unfold/issues",
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#141A1D",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agents",
    "coding agent",
    "remote agents",
    "ai",
    "opencode",
    "litellm",
    "self-hosted",
    "code review",
    "forgejo",
    "vikunja"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Session inspection works. Sending editor content requires a trusted workspace."
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onView:unfold.now",
    "onView:unfold.sessions",
    "onView:unfold.tasks",
    "onView:unfold.ploeg",
    "onWebviewPanel:unfold.session",
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "unfold.connect",
