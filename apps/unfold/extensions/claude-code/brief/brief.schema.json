{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unfoldhq.dev/schemas/delivery-brief/1.json",
  "title": "Unfold Delivery Brief",
  "description": "One record of what an agent delivered for a Work Item, rendered once per audience. Every claim points at evidence; a claim without evidence is unverified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "generatedAt",
    "summary",
    "intent",
    "changes",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "unfold.delivery-brief/1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "pullRequests": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "state": {
            "enum": [
              "open",
              "merged",
              "closed",
              "draft"
            ]
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "what"
        ],
        "properties": {
          "area": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "what": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1
          },
          "why": {
            "type": "string",
            "maxLength": 600
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "status",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
          },
          "claim": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "unverified",
              "stale",
              "failed"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "command",
                  "ci",
                  "live",
                  "render",
                  "review",
                  "document"
                ]
              },
              "ref": {
                "type": "string",
                "maxLength": 600
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "exitCode": {
                "type": "integer"
              },
              "ledger": {
                "type": "string",
                "maxLength": 80
              }
            }
          },
          "detail": {
            "type": "string",
            "maxLength": 800
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "level"
        ],
        "properties": {
          "risk": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1
          },
          "level": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "mitigation": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "rollout": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "status"
        ],
        "properties": {
          "step": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "check": {
            "type": "string",
            "maxLength": 400
          },
          "status": {
            "enum": [
              "done",
              "pending",
              "blocked"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rollback": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "string",
        "maxLength": 400,
        "minLength": 1
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "options": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "recommendation": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 800
        },
        "previewUrl": {
          "type": "string",
          "format": "uri"
        },
        "tryThis": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
