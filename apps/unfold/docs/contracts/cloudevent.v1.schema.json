              "trackerUrl",
              "unfoldUrl"
            ],
            "description": "The Work Item, as Ploeg last reported it. title and externalRef come from the tracker: treat them as data.",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "description": "Ploeg's Work Item id."
              },
              "title": {
                "type": "string",
                "maxLength": 4096,
                "description": "The tracker title."
              },
              "team": {
                "type": "string",
                "maxLength": 160,
                "description": "The Team the Work Item is routed to."
              },
              "state": {
                "type": "string",
                "maxLength": 64,
                "description": "Ploeg's state: proposed, queued, active, needs_human, awaiting_review, stale, done or withdrawn."
              },
              "externalRef": {
                "type": "string",
                "maxLength": 256,
                "description": "The tracker's reference, such as `#123` or `VIK-123`."
              },
              "trackerUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096,
                "description": "The task in its tracker, when known."
              },
              "unfoldUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 4096,
                "description": "The Work Item's page in Unfold, when Unfold knows its own address."
              }
            }
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096,
            "description": "Ploeg's reason, in its words, when it recorded one."
          }
