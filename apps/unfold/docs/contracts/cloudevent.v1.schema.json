{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgejo.webgrip.dev/webgrip/unfold/raw/branch/development/apps/unfold/docs/contracts/cloudevent.v1.schema.json",
  "title": "Unfold outbound event (CloudEvents 1.0, structured JSON mode)",
  "description": "Every event Unfold delivers to a webhook subscription. A CloudEvents 1.0.2 event in structured JSON mode with the extension attributes tenant and client. Generated from apps/unfold/src/outbound/catalogue.ts; supersedes the proposed event-envelope.v1.schema.json for published events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "tenant",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0",
      "description": "CloudEvents version."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Unique per event; also the webhook-id header, the same on every retry."
    },
    "source": {
      "type": "string",
      "pattern": "^/tenants/[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:/clients/[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)?$",
      "description": "The owner: /tenants/<tenant>, or /tenants/<tenant>/clients/<client>."
    },
    "type": {
      "type": "string",
      "pattern": "^dev\\.unfold\\.[a-z_]+\\.[a-z_]+$",
      "description": "The event type."
    },
    "subject": {
      "type": "string",
      "maxLength": 200,
      "description": "What the event is about within its source, such as work-items/42."
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "When the fact happened, in UTC."
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri",
      "description": "This schema, pointing at the type's data definition."
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Extension attribute: the Tenant that owns the event."
    },
    "client": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Extension attribute: the Client inside the Tenant, when the work belongs to one."
    },
    "data": {
      "type": "object",
      "description": "The type's data; see $defs/data."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.work_item.proposed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/work_item.proposed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.work_item.approved"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/work_item.approved"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.work_item.handed_off"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/work_item.handed_off"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.work_item.needs_you"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/work_item.needs_you"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.work_item.ready_for_review"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/work_item.ready_for_review"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.work_item.done"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/work_item.done"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.pull_request.opened"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/pull_request.opened"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.run.finished"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/run.finished"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.client_sign_off.recorded"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/client_sign_off.recorded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.client_sign_off.withdrawn"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/client_sign_off.withdrawn"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.client_sign_off.dismissed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/client_sign_off.dismissed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.delivery.accepted"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/delivery.accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "dev.unfold.webhook.test"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/data/webhook.test"
          }
        }
      }
    }
  ],
  "$defs": {
    "signOff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "answer",
        "state",
        "headSha",
        "pullRequestUrl",
        "attribution"
      ],
      "description": "A Client Sign-off, input to the Agency's Acceptance, never Acceptance itself. It carries no note and no person.",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "description": "The Sign-off id."
        },
        "answer": {
          "enum": [
            "looks_good",
            "needs_changes"
          ]
        },
        "state": {
          "enum": [
            "current",
            "dismissed",
            "withdrawn"
          ]
        },
        "headSha": {
          "type": "string",
          "maxLength": 64,
          "description": "The head commit it is bound to."
        },
        "pullRequestUrl": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096,
          "description": "The pull request."
        },
        "attribution": {
          "enum": [
            "proven",
            "asserted"
          ]
        }
      }
    },
