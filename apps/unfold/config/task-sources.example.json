{
  "mode": "live",
  "host": "127.0.0.1",
  "port": 4080,
  "dataDir": ".unfold",
  "runtime": {
    "kind": "opencode",
    "backend": "local",
    "binary": "opencode",
    "timeoutMs": 3600000
  },
  "maxConcurrentSessions": 1,
  "maxBudgetUsd": 10,
  "models": [
    {
      "id": "coding",
      "name": "Configured coding model",
      "providerId": "gateway",
      "modelId": "replace-with-your-litellm-model-alias"
    }
  ],
  "repositories": [
    {
      "id": "application",
      "name": "Application",
      "description": "Operator-approved repository",
      "url": "https://forge.example/organization/application.git",
      "baseBranch": "main",
      "verify": ["node", "--test"],
      "executionOwner": "interactive"
    }
  ],
  "taskSources": [
    {
      "id": "forgejo-application",
      "name": "Application · Forgejo",
      "provider": "forgejo",
      "baseUrl": "https://forge.example/api/v1",
      "project": "organization/application",
      "repositoryId": "application",
      "tokenEnv": "UNFOLD_TASK_FORGEJO_TOKEN",
      "executionOwner": "interactive"
    },
    {
      "id": "github-application",
      "name": "Application · GitHub",
      "provider": "github",
      "baseUrl": "https://api.github.com",
      "project": "organization/application",
      "repositoryId": "application",
      "tokenEnv": "UNFOLD_TASK_GITHUB_TOKEN",
      "executionOwner": "interactive"
    },
    {
      "id": "gitlab-application",
      "name": "Application · GitLab",
      "provider": "gitlab",
      "baseUrl": "https://gitlab.example/api/v4",
      "project": "organization/application",
      "repositoryId": "application",
      "tokenEnv": "UNFOLD_TASK_GITLAB_TOKEN",
      "executionOwner": "interactive"
    },
    {
      "id": "clickup-application",
      "name": "Application · ClickUp",
      "provider": "clickup",
      "baseUrl": "https://api.clickup.com/api/v2",
      "project": "901234567890",
      "repositoryId": "application",
      "tokenEnv": "UNFOLD_TASK_CLICKUP_TOKEN",
      "executionOwner": "interactive"
    },
    {
      "id": "vikunja-application",
      "name": "Application · Vikunja",
      "provider": "vikunja",
      "baseUrl": "https://tasks.example/api/v1",
      "project": "42",
      "repositoryId": "application",
      "tokenEnv": "UNFOLD_TASK_VIKUNJA_TOKEN",
      "executionOwner": "interactive"
    },
    {
      "id": "jira-application",
      "name": "Application · Jira",
      "provider": "jira",
      "baseUrl": "https://example.atlassian.net/rest/api/3",
      "project": "APP",
      "repositoryId": "application",
      "tokenEnv": "UNFOLD_TASK_JIRA_TOKEN",
      "executionOwner": "interactive"
    }
  ],
  "litellm": {
    "baseUrl": "https://gateway.internal.example/v1"
  },
  "ploeg": {
    "url": "https://ploeg.internal.example",
    "tokenEnv": "PLOEG_OPERATOR_UNFOLD_TOKEN",
    "teams": [
      "delivery"
    ],
    "userTeams": {
      "replace-with-user-id": [
        "delivery"
      ]
    }
  },
  "execution": {
    "team": "delivery",
    "heartbeatMs": 15000
  }
}
