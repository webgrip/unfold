---
import AudiencePage from '../../components/AudiencePage.astro';
import RunEnvelope from '../../components/objects/RunEnvelope.astro';
import { dictionary } from '../../i18n/index.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const t = dictionary('en');
---

<BaseLayout
  locale="en"
  routeKey="forPlatform"
  title={t.meta.platformTitle}
  description={t.meta.platformDescription}
>
  <AudiencePage locale="en" audience="platform">
    <RunEnvelope slot="object" locale="en" />
  </AudiencePage>
</BaseLayout>
