---
import SignupOutcome from '../components/SignupOutcome.astro';
import { dictionary } from '../i18n/index.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const t = dictionary('en');
---

<BaseLayout
  locale="en"
  routeKey="thanks"
  title={t.meta.thanksTitle}
  description={t.meta.thanksDescription}
  noindex
>
  <SignupOutcome locale="en" outcome="thanks" />
</BaseLayout>
