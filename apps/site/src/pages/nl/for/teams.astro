---
import AudiencePage from '../../../components/AudiencePage.astro';
import ReasonBoard from '../../../components/objects/ReasonBoard.astro';
import { dictionary } from '../../../i18n/index.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const t = dictionary('nl');
---

<BaseLayout
  locale="nl"
  routeKey="forTeams"
  title={t.meta.teamsTitle}
  description={t.meta.teamsDescription}
>
  <AudiencePage locale="nl" audience="teams">
    <ReasonBoard slot="object" locale="nl" />
  </AudiencePage>
</BaseLayout>
