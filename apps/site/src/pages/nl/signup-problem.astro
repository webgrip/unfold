---
import SignupOutcome from '../../components/SignupOutcome.astro';
import { dictionary } from '../../i18n/index.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const t = dictionary('nl');
---

<BaseLayout
  locale="nl"
  routeKey="signupProblem"
  title={t.meta.problemTitle}
  description={t.meta.problemDescription}
  noindex
>
  <SignupOutcome locale="nl" outcome="problem" />
</BaseLayout>
