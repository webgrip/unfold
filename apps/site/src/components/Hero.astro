---
import { SOURCE_URL } from '../config/site.ts';
import timeline from '../data/demo-timeline.json';
import type { Locale } from '../i18n/config.ts';
import { dictionary } from '../i18n/index.ts';
import Mark from './Mark.astro';
interface Props {
  locale: Locale;
}
const t = dictionary(Astro.props.locale);
const r = t.redesign;
const change = timeline.diff.split('\n').filter((line) => /^[+-]/.test(line));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title">{r.heroLine}<br /><span>{r.heroAccent}</span></h1>
      <p class="hero-intro">{r.heroIntro}</p>
      <div class="button-row">
        <a class="button button--primary" href="#how"
          ><span class="play-symbol" aria-hidden="true">▷</span>{r.explore}</a
        >
        <a class="button button--secondary" href={SOURCE_URL}>{r.source}</a>
      </div>
      <p class="hero-category">{r.category}</p>
    </div>
    <div class="flight-board">
      <div class="board-header">
        <span class="micro">{r.recorded}</span><span class="micro">{t.loop.steps[1]?.term}</span>
      </div>
      <div class="flight-item">
        <span class="micro">{t.hero.visual.workItem}</span>
        <h2 lang="en">{timeline.workItem.title}</h2>
        <div class="item-meta">
          <span>{timeline.workItem.repository}</span><span>1.005 ≠ 1.00</span>
        </div>
      </div>
      <div class="run-track">
        <div class="flight-line" aria-hidden="true">
          <span class="flight-plane"><Mark size={48} /></span>
        </div>
        <div class="run-node">
          <span class="node-check" aria-hidden="true">✓</span
          ><span>{r.implementation}<small>{r.testsPass}</small></span>
        </div>
        <div class="run-node">
          <span class="node-check" aria-hidden="true">✓</span
          ><span>{r.independent}<small>{r.testsPass}</small></span>
        </div>
      </div>
      <div class="flight-result">
        <div class="result-top">
          <span class="micro">{r.localResult}</span><span class="change-count">{r.oneChange}</span>
        </div>
        <pre
          role="region"
          aria-label={r.diff}
          tabindex="0"
        ><code>{change.map((line) => <span class={line.startsWith('+') ? 'added' : 'removed'}>{line}{'\n'}</span>)}</code></pre>
        <div class="human-handoff">
          <span class="human-icon" aria-hidden="true">◎</span>
          <div>
            <strong>{r.handoff}</strong>
            <p>{r.handoffNote}</p>
          </div>
        </div>
      </div>
      <p class="board-note">{r.demoBadge}</p>
    </div>
  </div>
  <ul class="container proof-strip">
    {r.proof.map((proof) => <li>{proof}</li>)}
  </ul>
</section>
<style>
  .hero {
    padding-top: clamp(3rem, 6vw, 6rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-bottom: 5rem;
  }
  .hero-grid > * {
    min-width: 0;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  h1 {
    font-size: clamp(3.15rem, 5.2vw, 5rem);
    line-height: 1.025;
    letter-spacing: -0.06em;
    margin: 1.5rem 0;
    text-wrap: initial;
  }
  h1 span {
    color: var(--accent);
  }
  .hero-intro {
    max-width: 42ch;
    font-size: 1.125rem;
    color: var(--fg-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .hero-category {
    margin-top: 1.5rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }
  .play-symbol {
    font-size: 1.3rem;
    line-height: 1;
  }
  .flight-board {
    container-type: inline-size;
    position: relative;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg);
    border-radius: 3px;
  }
  .flight-board::before {
    content: '';
    position: absolute;
    inset: 12px -12px -12px 12px;
    z-index: -1;
    border: 1px solid var(--border);
  }
  .board-header,
  .item-meta,
  .result-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .board-header {
    padding-bottom: 1.5rem;
    color: var(--fg-muted);
  }
  .board-header .micro:first-child {
    color: var(--accent);
  }
  .flight-item {
    border: 1px solid var(--border-strong);
    padding: 1.2rem;
    background: var(--bg);
    position: relative;
  }
  .flight-item h2 {
    font-size: 1.2rem;
    margin: 0.6rem 0 1rem;
    letter-spacing: -0.02em;
  }
  .item-meta {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--fg-muted);
  }
  .run-track {
    position: relative;
    padding: 1.8rem 0 1.8rem 4.3rem;
    display: grid;
    gap: 1.4rem;
  }
  .flight-line {
    position: absolute;
    inset: 0 auto 0 1.6rem;
    border-left: 1px dashed var(--accent-decor);
  }
  .flight-plane {
    position: absolute;
    left: -1.55rem;
    top: 1.55rem;
    background: var(--bg);
  }
  .run-node {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .run-node small {
    display: block;
    font-size: 0.75rem;
    color: var(--fg-muted);
    font-weight: 400;
  }
  .run-node > span {
    min-width: 0;
  }
  .node-check {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
  }
  .flight-result {
    transform-origin: 50% 0;
    border: 1px solid var(--accent-decor);
    background: var(--bg);
  }
  .result-top {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .change-count {
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  pre {
    margin: 0;
    padding: 1rem;
    font: 0.7rem/1.9 var(--font-mono);
    overflow-x: auto;
  }
  pre span {
    display: block;
  }
  .removed {
    color: var(--fg-muted);
    text-decoration: line-through;
  }
  .added {
    color: var(--fg);
  }
  .human-handoff {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--border);
  }
  .human-icon {
    color: var(--accent);
    font-size: 2rem;
  }
  .human-handoff strong {
    font-size: 1rem;
  }
  .human-handoff p {
    font-size: 0.75rem;
    color: var(--fg-muted);
  }
  .board-note {
    font-size: 0.75rem;
    margin-top: 1.2rem;
    color: var(--fg-muted);
  }
  .proof-strip {
    list-style: none;
    padding: 1.4rem 0;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-block: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--fg-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .flight-item {
      animation: arrive 700ms var(--ease-out) both;
    }
    .run-node {
      min-width: 0;
      animation: arrive 700ms 250ms var(--ease-out) both;
    }
    .run-node:last-child {
      animation-delay: 500ms;
    }
    .flight-result {
      animation: unfold 900ms 750ms var(--ease-out) both;
    }
    .flight-plane {
      animation: takeoff 1800ms var(--ease-out) both;
    }
  }
  @container (max-width: 15rem) {
    .run-track {
      padding: 1.25rem 0;
    }
    .flight-line {
      display: none;
    }
  }
  @keyframes unfold {
    from {
      transform: perspective(900px) rotateX(-12deg) translateY(10px);
    }
    to {
      transform: none;
    }
  }
  @keyframes arrive {
    from {
      transform: translateY(14px);
    }
    to {
      transform: none;
    }
  }
  @keyframes takeoff {
    from {
      transform: translateY(75px);
    }
    to {
      transform: none;
    }
  }
  @media (max-width: 62rem) {
    .hero-grid {
      gap: 2rem;
    }
    h1 {
      font-size: clamp(3rem, 5.5vw, 4.3rem);
    }
  }
  @media (max-width: 48rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      padding-bottom: 3rem;
    }
    h1 {
      font-size: clamp(3rem, 10vw, 5rem);
    }
    .hero-intro {
      max-width: 50ch;
    }
    .flight-board {
      max-width: 36rem;
      width: 100%;
      margin-inline: auto;
    }
    .proof-strip {
      display: grid;
      grid-template-columns: 1fr 1fr;
      font-size: 0.75rem;
    }
  }
  @media (max-width: 24rem) {
    h1 {
      font-size: 2.7rem;
    }
    .flight-board {
      padding: 1rem;
    }
    .proof-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
