---
import { DOCS_URL, LICENSE_URL, SOURCE_URL } from '../config/site.ts';
import type { Locale } from '../i18n/config.ts';
import { dictionary } from '../i18n/index.ts';
import Mark from './Mark.astro';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
}

const t = dictionary(Astro.props.locale);
const links = [
  { href: SOURCE_URL, label: t.footer.source },
  { href: DOCS_URL, label: t.footer.docs },
  { href: LICENSE_URL, label: t.footer.license },
  { href: '/fonts/OFL.txt', label: t.footer.fontLicense },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="footer-lockup">
        <Mark size={28} />
        <Wordmark />
      </div>
      <p>{t.footer.summary}</p>
      <p class="footer-meta">{t.footer.origin}</p>
    </div>
    <ul class="footer-links">
      {links.map((link) => <li>
        <a href={link.href}>{link.label}</a>
      </li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border-width) solid var(--border);
    background: var(--bg-band);
    padding-block: var(--space-7) var(--space-6);
    font-size: var(--text-sm);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .footer-lockup {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-brand p {
    margin-top: var(--space-3);
    color: var(--fg-muted);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .footer-links a {
    color: var(--fg-muted);
  }

  .footer-links a:hover {
    color: var(--fg);
  }
</style>
