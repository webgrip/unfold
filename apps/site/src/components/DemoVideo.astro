---
import video from '../data/demo-video.json';
import type { Locale } from '../i18n/config.ts';
import { dictionary } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const t = dictionary(Astro.props.locale).how.video;
const webm = video.sources.find((source) => source.type === 'video/webm');
---

<figure class="video card">
  <div class="video-head">
    <h3 class="video-title">{t.title}</h3>
    <p class="video-lead">{t.lead}</p>
  </div>
  <div class="video-frame">
    <video
      class="video-player"
      data-demo-video
      width={video.width}
      height={video.height}
      poster={video.poster}
      muted
      playsinline
      controls
      preload="none"
    >
      {video.sources.map((source) => (
        <source src={source.src} type={source.type} />
      ))}
      <p>
        {t.fallback}
        {webm && <a href={webm.src}>{webm.src.split('/').pop()}</a>}
      </p>
    </video>
  </div>
  <figcaption class="video-caption">{t.caption} {video.unfoldVersion}.</figcaption>
</figure>

<style>
  .video {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    margin: 0;
  }

  @media (max-width: 44rem) {
    .video {
      padding: var(--space-4);
    }
  }

  .video-title {
    font-size: var(--text-xl);
  }

  .video-lead {
    margin-top: var(--space-2);
    color: var(--fg-muted);
  }

  .video-frame {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: var(--border-width) solid var(--border-strong);
    background: var(--code-bg);
  }

  .video-player {
    display: block;
    width: 100%;
    height: auto;
  }

  .video-caption {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
</style>
