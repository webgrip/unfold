---
import { DEMO_GUIDE_URL, DOCS_URL, LICENSE_URL, SOURCE_URL } from '../config/site.ts';
import type { Locale } from '../i18n/config.ts';
import { dictionary } from '../i18n/index.ts';

interface Props {
  locale: Locale;
}

const t = dictionary(Astro.props.locale);
---

<section class="hero section" aria-labelledby="hero-title">
  <div class="container">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 id="hero-title">{t.hero.title}</h1>
    <p class="lede hero-lede">{t.hero.lede}</p>
    <div class="button-row hero-actions">
      <a class="button button--primary" href={SOURCE_URL}>{t.hero.primary}</a>
      <a class="button button--secondary" href={DEMO_GUIDE_URL}>{t.hero.secondary}</a>
    </div>
    <p class="note">{t.hero.demoNote}</p>
  </div>
</section>

<section id="loop" class="section section--band" aria-labelledby="loop-title">
  <div class="container">
    <h2 id="loop-title" class="section-title">{t.loop.title}</h2>
    <p class="lede">{t.loop.intro}</p>
    <ol class="loop">
      {t.loop.steps.map((step, index) => <li class="loop-step card">
        <span class="loop-index" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3>{step.term}</h3>
        <p>{step.text}</p>
      </li>)}
    </ol>
    <p class="note planned">{t.loop.planned}</p>
  </div>
</section>

<section id="parts" class="section" aria-labelledby="parts-title">
  <div class="container">
    <h2 id="parts-title" class="section-title">{t.parts.title}</h2>
    <div class="grid grid--2">
      {t.parts.items.map((part) => <article class="card part">
        <p class="part-role">{part.role}</p>
        <h3>{part.name}</h3>
        <p>{part.text}</p>
      </article>)}
    </div>
    <p class="note">{t.parts.version}</p>
  </div>
</section>

<section class="section section--band" aria-labelledby="guards-title">
  <div class="container">
    <h2 id="guards-title" class="section-title">{t.guards.title}</h2>
    <dl class="grid grid--4 guards">
      {t.guards.items.map((item) => <div class="guard">
        <dt>{item.title}</dt>
        <dd>{item.text}</dd>
      </div>)}
    </dl>
  </div>
</section>

<section class="section" aria-labelledby="open-title">
  <div class="container split">
    <div>
      <h2 id="open-title" class="section-title">{t.open.title}</h2>
      <p>{t.open.text}</p>
      <p class="links">
        <a href={LICENSE_URL}>{t.open.license}</a>
        <a href={DOCS_URL}>{t.open.docs}</a>
      </p>
    </div>
    <div id="status">
      <h2 class="section-title">{t.status.title}</h2>
      <dl class="status">
        {t.status.items.map((item) => <div class="status-item">
          <dt>{item.label}</dt>
          <dd>{item.text}</dd>
        </div>)}
      </dl>
    </div>
  </div>
</section>

<section class="section cta" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <h2 id="cta-title">{t.cta.title}</h2>
    <p>{t.cta.text}</p>
    <div class="button-row">
      <a class="button button--primary" href={SOURCE_URL}>{t.hero.primary}</a>
      <a class="button button--secondary" href={DEMO_GUIDE_URL}>{t.hero.secondary}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
  }

  .eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .hero h1 {
    max-width: 20ch;
  }

  .hero-lede {
    margin-top: var(--space-5);
    max-width: 60ch;
  }

  .hero-actions {
    margin-top: var(--space-6);
  }

  .note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .loop {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    counter-reset: none;
  }

  .loop-step h3 {
    margin-top: var(--space-2);
  }

  .loop-step p {
    margin-top: var(--space-2);
    color: var(--fg-muted);
  }

  .loop-index {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .planned {
    border-left: 3px solid var(--accent-decor);
    padding-left: var(--space-3);
    margin-top: var(--space-5);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
  }

  .grid--2 {
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .grid--4 {
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .part-role {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--accent);
  }

  .part h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-1);
  }

  .part p:last-child {
    margin-top: var(--space-3);
  }

  .guard dt {
    font-weight: var(--weight-display);
    font-size: var(--text-lg);
  }

  .guard dd {
    margin-top: var(--space-2);
    color: var(--fg-muted);
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-7);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .status {
    display: grid;
    gap: var(--space-4);
  }

  .status-item {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: var(--border-width) solid var(--border);
  }

  .status-item dt {
    font-weight: var(--weight-semibold);
  }

  @media (max-width: 30rem) {
    .status-item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  .cta {
    border-top: var(--border-width) solid var(--border);
  }

  .cta-inner {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .cta-inner p {
    color: var(--fg-muted);
  }
</style>
