---
import {
  DEMO_GUIDE_URL,
  DEMO_REPLAY_PATH,
  DOCS_URL,
  LICENSE_URL,
  SOURCE_URL,
} from '../config/site.ts';
import type { Locale } from '../i18n/config.ts';
import { dictionary } from '../i18n/index.ts';
import DemoVideo from './DemoVideo.astro';
import Hero from './Hero.astro';
import Pricing from './Pricing.astro';
import SignupForm from './SignupForm.astro';
import ShiftExplorer from './ShiftExplorer.astro';
import Walkthrough from './Walkthrough.astro';
import Mark from './Mark.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = dictionary(locale);
const r = t.redesign;
---

<Hero locale={locale} />
<section id="how" class="section" aria-labelledby="how-title">
  <div class="container">
    <p class="eyebrow">{r.howKicker}</p>
    <div class="section-heading">
      <h2 id="how-title" class="section-title">{r.howTitle}</h2>
      <p>{r.howIntro}</p>
    </div>
    <ShiftExplorer locale={locale} />
    <div class="replay-link">
      <span>{r.recordingNote}</span><a href={DEMO_REPLAY_PATH}>{t.how.replay.link}</a
      ><a href={DEMO_GUIDE_URL}>{t.how.runIt}</a>
    </div>
    <details class="recording-details">
      <summary>{r.recording}</summary>
      <div class="recording-body"><Walkthrough locale={locale} /><DemoVideo locale={locale} /></div>
    </details>
  </div>
</section>
<section id="guardrails" class="section guards-section" aria-labelledby="guards-title">
  <div class="container guards-layout">
    <div class="guard-intro">
      <p class="eyebrow">{r.guardKicker}</p>
      <h2 id="guards-title" class="section-title">{r.guardTitle}</h2>
      <p>{r.guardIntro}</p>
      <div class="guard-brand" aria-hidden="true">
        <Mark size={96} /><span>{t.loop.steps[3]?.term}</span>
      </div>
    </div>
    <dl class="guards">
      {t.guards.items.map((item, index) => <div class="guard">
        <dt>
          <span class="guard-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span
          >{item.title}
        </dt>
        <dd>{item.text}</dd>
      </div>)}
    </dl>
  </div>
</section>
<section id="parts" class="section architecture" aria-labelledby="parts-title">
  <div class="container">
    <p class="eyebrow">{r.archKicker}</p>
    <div class="section-heading">
      <h2 id="parts-title" class="section-title">{r.archTitle}</h2>
      <p>{r.archIntro}</p>
    </div>
    <div class="architecture-map">
      <div class="cluster-label micro">{r.cluster}</div>
      <div class="map-flow">
        <div class="map-node workbench">
          <span class="micro">{t.parts.items[1]?.role}</span>
          <h3>{t.parts.items[1]?.name}</h3>
          <p>{r.front}</p>
        </div>
        <div class="map-connector" aria-hidden="true"><span /></div>
        <div class="map-node engine">
          <span class="micro">{t.parts.items[0]?.role}</span>
          <h3>{t.parts.items[0]?.name}</h3>
          <p>{r.engine}</p>
          <div class="engine-runs"><span>{r.implementation}</span><span>{r.independent}</span></div>
        </div>
        <div class="map-connector" aria-hidden="true"><span /></div>
        <div class="map-node output">
          <span class="micro">{r.forge}</span>
          <h3>{t.hero.visual.pullRequest}</h3>
          <p>{r.workerPath}</p>
        </div>
      </div>
      <div class="map-services">
        <div><strong>PostgreSQL</strong><span>{r.store}</span></div>
        <div><strong>LiteLLM</strong><span>{r.gateway} / {r.providers}</span></div>
      </div>
    </div>
    <p class="map-note">{r.architectureNote}</p>
    <div class="parts-detail">
      {t.parts.items.map((part) => <article>
        <h3>{part.name}{' '}<span>{part.role}</span></h3>
        <p>{part.text}</p>
      </article>)}
    </div>
  </div>
</section>
<section id="status" class="section open-section" aria-labelledby="open-title">
  <div class="container open-layout">
    <div>
      <p class="eyebrow">{r.openKicker}</p>
      <h2 id="open-title" class="section-title">{r.openTitle}</h2>
      <p class="open-intro">{r.openIntro}</p>
      <div class="button-row">
        <a class="button button--primary" href={DOCS_URL}>{t.open.docs}</a
        ><a class="button button--secondary" href={SOURCE_URL}>{r.source}</a>
      </div>
      <a class="license-link" href={LICENSE_URL}>{t.open.license}</a>
    </div>
    <div>
      <h3 class="status-title">{r.statusTitle}</h3>
      <dl class="status">
        {t.status.items.map((item, index) => <div>
          <dt><span class={`status-marker marker-${index}`} aria-hidden="true" />{item.label}</dt>
          <dd>{item.text}</dd>
        </div>)}
      </dl>
      <p class="planned-note">{t.loop.planned}</p>
    </div>
  </div>
</section>
<Pricing locale={locale} />
<SignupForm locale={locale} />
<style>
  .replay-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 1.25rem 0;
    font-size: 0.8rem;
  }
  .replay-link span {
    margin-right: auto;
    color: var(--fg-muted);
  }
  .recording-details {
    border-block: 1px solid var(--border);
    margin-top: 1rem;
  }
  summary {
    padding: 1.25rem 0;
    font-size: 0.875rem;
    font-weight: 650;
  }
  .recording-body {
    display: grid;
    gap: 2rem;
    padding-bottom: 2rem;
  }
  .guards-section {
    border-block: 1px solid var(--border);
    background: var(--bg-raised);
  }
  .guards-layout {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 6rem;
  }
  .guard-intro .section-title {
    margin: 1.3rem 0 1.5rem;
  }
  .guard-intro > p:last-of-type {
    color: var(--fg-muted);
  }
  .guard-brand {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    font: 0.75rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }
  .guard {
    display: block;
    padding: 1.6rem 0;
    border-top: 1px solid var(--border);
  }
  .guard:last-child {
    border-bottom: 1px solid var(--border);
  }
  .guard-number {
    font: 0.75rem var(--font-mono);
    color: var(--accent);
    padding-top: 0.2rem;
  }
  .guard dt {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .guard dd {
    padding-left: 2.6rem;
    margin-top: 0.7rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .architecture-map {
    border: 1px solid var(--border-strong);
    padding: 1.75rem;
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
    background-size: 20px 20px;
  }
  .cluster-label {
    color: var(--fg-muted);
    padding-bottom: 2rem;
  }
  .map-flow {
    display: grid;
    grid-template-columns: 1fr 3rem 1.5fr 3rem 1fr;
    align-items: center;
  }
  .map-node {
    padding: 1.5rem;
    border: 1px solid var(--border-strong);
    background: var(--bg);
    min-height: 150px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .map-node .micro {
    color: var(--fg-muted);
  }
  .map-node h3 {
    font-size: 1.65rem;
    margin: 0.5rem 0;
  }
  .map-node p {
    color: var(--fg-muted);
    font-size: 0.75rem;
  }
  .engine {
    border-color: var(--accent-decor);
    padding: 2rem;
  }
  .engine > .micro {
    color: var(--accent);
  }
  .engine h3 {
    font-size: 2.5rem;
  }
  .engine-runs {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }
  .engine-runs span {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    font: 0.7rem var(--font-mono);
  }
  .map-connector {
    height: 1px;
    background: var(--border-strong);
    position: relative;
  }
  .map-connector span {
    position: absolute;
    right: -1px;
    top: -3px;
    width: 7px;
    height: 7px;
    border-right: 1px solid var(--fg-muted);
    border-top: 1px solid var(--fg-muted);
    transform: rotate(45deg);
  }
  .map-services {
    display: flex;
    gap: 2rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-strong);
    justify-content: center;
  }
  .map-services > div {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.8rem;
  }
  .map-services span {
    color: var(--fg-muted);
    font-size: 0.75rem;
  }
  .map-note {
    margin-top: 1rem;
    color: var(--fg-muted);
    font-size: 0.75rem;
  }
  .parts-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 2.5rem;
  }
  .parts-detail h3 {
    font-size: 1.2rem;
    margin-bottom: 0.8rem;
  }
  .parts-detail h3 span {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--fg-muted);
    margin-left: 1rem;
    letter-spacing: 0;
  }
  .parts-detail p {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .open-section {
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }
  .open-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
  }
  .open-layout .section-title {
    margin: 1.3rem 0 1.5rem;
  }
  .open-intro {
    color: var(--fg-muted);
    margin-bottom: 2rem;
  }
  .license-link {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.8rem;
  }
  .status-title {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .status > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.25rem;
    padding: 1.2rem 0;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }
  .status dt {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-weight: 600;
  }
  .status dd {
    color: var(--fg-muted);
  }
  .status-marker {
    width: 7px;
    height: 7px;
    border: 1px solid var(--fg-muted);
    flex: none;
  }
  .marker-0 {
    border-color: var(--accent-decor);
    background: var(--accent-decor);
  }
  .marker-1 {
    background: var(--fg-muted);
  }
  .planned-note {
    font-size: 0.8rem;
    color: var(--fg-muted);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  @media (max-width: 60rem) {
    .guards-layout,
    .open-layout {
      gap: 3rem;
    }
    .map-flow {
      grid-template-columns: 1fr 1.5rem 1.3fr 1.5rem 1fr;
    }
    .map-node,
    .engine {
      padding: 1rem;
    }
  }
  @media (max-width: 45rem) {
    .guards-layout,
    .open-layout,
    .parts-detail {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .guard-brand {
      display: none;
    }
    .map-flow {
      grid-template-columns: 1fr;
    }
    .map-connector {
      height: 2rem;
      width: 1px;
      justify-self: center;
    }
    .map-connector span {
      transform: rotate(135deg);
      top: auto;
      bottom: 0;
      left: -3px;
    }
    .map-node {
      text-align: center;
      min-height: 0;
      padding: 1.5rem;
    }
    .engine-runs {
      justify-content: center;
    }
    .map-services {
      flex-direction: column;
      gap: 1rem;
    }
    .map-services > div {
      align-items: start;
      flex-direction: column;
      gap: 0.2rem;
    }
    .status > div {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
