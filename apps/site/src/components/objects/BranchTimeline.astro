---
import type { Locale } from '../../i18n/config.ts';
import { dictionary } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
}

const o = dictionary(Astro.props.locale).developers.object;
---

<figure class="branch" aria-labelledby="branch-caption">
  <div class="branch-lanes" aria-hidden="true">
    <span class="lane-name lane-name--agent micro">{o.agent}</span>
    <span class="lane-name lane-name--you micro">{o.you}</span>
  </div>
  <div class="branch-track">
    <span class="rail rail--agent" aria-hidden="true"></span>
    <span class="rail rail--you" aria-hidden="true"></span>
    <span class="rail rail--paused micro" aria-hidden="true"><span>{o.paused}</span></span>
    <ol class="branch-steps" role="list">
      {o.steps.map((step) => <li class={`step step--${step.lane}`}>
        <span class="sr-only">{step.lane === 'you' ? o.you : o.agent}: </span>
        <span class="step-dot" aria-hidden="true"></span>
        <span class="step-text">{step.text}</span>
      </li>)}
    </ol>
  </div>
  <figcaption id="branch-caption" class="object-caption">
    <span class="sr-only">{o.label}. </span>{o.caption}
  </figcaption>
</figure>

<style>
  .branch {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 1.5rem;
  }
  .branch-lanes {
    display: grid;
    grid-template-rows: 5.5rem 5.5rem;
    align-items: start;
  }
  .lane-name {
    padding-top: 0.15rem;
    color: var(--fg-muted);
  }
  .lane-name--you {
    color: var(--accent);
  }
  .branch-track {
    position: relative;
    min-width: 0;
  }
  .rail {
    position: absolute;
    height: 3px;
    left: 0;
    right: 0;
    background: var(--fg);
  }
  .rail--agent {
    top: 0.45rem;
  }
  .rail--paused {
    top: 0.45rem;
    left: calc((100% / 7) * 2 + 1.25rem);
    right: calc((100% / 7) * 2 + 0.75rem);
    height: 3px;
    background: var(--bg);
    border-top: 3px dashed var(--fg-muted);
    display: flex;
    justify-content: center;
  }
  .rail--paused span {
    margin-top: 1.1rem;
    color: var(--fg-muted);
    font-size: 0.65rem;
    text-align: center;
  }
  .rail--you {
    top: calc(5.5rem + 0.45rem);
    left: calc((100% / 7) * 2 + 0.5rem);
    right: calc((100% / 7) * 2 - 0.25rem);
    background: var(--accent);
    transform-origin: left center;
  }
  .rail--you::before,
  .rail--you::after {
    content: '';
    position: absolute;
    bottom: 0;
    width: 3px;
    height: 5.5rem;
    background: inherit;
  }
  .rail--you::before {
    left: -0.5rem;
    transform: skewX(-12deg);
    transform-origin: bottom;
  }
  .rail--you::after {
    right: -0.25rem;
    transform: skewX(12deg);
    transform-origin: bottom;
  }
  .branch-steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    grid-template-rows: 5.5rem auto;
  }
  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-right: 0.75rem;
    max-width: none;
    min-width: 0;
    grid-row: 1;
  }
  .step--you {
    grid-row: 2;
  }
  .step:nth-child(1) {
    grid-column: 1;
  }
  .step:nth-child(2) {
    grid-column: 2;
  }
  .step:nth-child(3) {
    grid-column: 3;
  }
  .step:nth-child(4) {
    grid-column: 4;
  }
  .step:nth-child(5) {
    grid-column: 5;
  }
  .step:nth-child(6) {
    grid-column: 6;
  }
  .step:nth-child(7) {
    grid-column: 7;
  }
  .step-dot {
    width: 1rem;
    height: 1rem;
    border: 3px solid var(--fg);
    background: var(--bg);
    border-radius: 50%;
    position: relative;
    z-index: 1;
  }
  .step--you .step-dot {
    border-color: var(--accent);
    background: var(--accent);
  }
  .step:last-child .step-dot {
    background: var(--fg);
  }
  .step-text {
    font-size: 0.82rem;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .step:last-child .step-text {
    font-weight: 800;
  }
  @media (prefers-reduced-motion: no-preference) {
    .rail--you {
      animation: branch-draws 700ms var(--ease-out) 300ms both;
    }
  }
  @keyframes branch-draws {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @container (max-width: 52rem) {
    .branch {
      grid-template-columns: minmax(0, 1fr);
    }
    .branch-lanes,
    .rail {
      display: none;
    }
    .branch-steps {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
    }
    .branch-steps .step:nth-child(n) {
      grid-row: auto;
      grid-column: auto;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.9rem;
      padding: 0.7rem 0 0.7rem 0.75rem;
      border-left: 3px solid var(--fg);
    }
    .branch-steps .step--you:nth-child(n) {
      margin-left: 1.5rem;
      border-left-color: var(--accent);
    }
  }
</style>
