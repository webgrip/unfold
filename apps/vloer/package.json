{
  "name": "@webgrip/de-vloer",
  "version": "0.3.0-rc.16",
  "private": true,
  "description": "A self-hosted operator workbench for remote agent crews",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "demo": "node --env-file-if-exists=.env src/main.ts --demo",
    "demo:unified": "node scripts/unified-demo.ts",
    "test": "node --test test/*.test.ts test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "user:add": "node scripts/user-add.ts",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-check.mjs",
    "backlog": "node scripts/backlog.mjs",
    "backlog:build": "node scripts/backlog.mjs build",
    "design:build": "node scripts/build-design.mjs",
    "design:check": "node scripts/build-design.mjs --check",
    "brand:build": "node scripts/build-brand.mjs",
    "brand:social": "node scripts/build-brand.mjs --png --social",
    "brand:check": "node scripts/build-brand.mjs --check && bash scripts/brand-marks.sh",
    "license:check": "node scripts/license-check.mjs",
    "license:reuse": "uvx --from 'reuse[charset-normalizer]==6.2.0' reuse lint",
    "extension:build": "npm --prefix extensions/vscode run compile",
    "extension:test": "npm --prefix extensions/vscode test",
    "extension:package": "npm --prefix extensions/vscode run package",
    "extension:verify": "node scripts/extension-verify.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  }
}
