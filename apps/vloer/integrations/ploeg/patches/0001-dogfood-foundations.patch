+	}}
+	ev := provider.TrackerEvent{
+		Kind: provider.TrackerAssigned, ExternalID: "42", Team: "docs", Scope: provider.Scope{ID: "old"},
+	}
+	item, err := s.mirror(context.Background(), tp, ev)
+	if err == nil || item.ExternalScope != "current" || item.Target != nil || item.RouteRule != "" {
+		t.Fatalf("conflicting scope was not rejected with current identity intact: item=%+v err=%v", item, err)
+	}
