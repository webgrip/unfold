+	writer, err := testStore.ClaimRole(ctx, "bronze", "builder", time.Minute, 1)
+	if err != nil || writer == nil {
+		t.Fatalf("claim builder: %v", err)
+	}
+	if _, err := testStore.ReportOutcome(ctx, writer.RunToken,
+		store.Report(work.OutcomePROpened, "opened", "", []string{"https://forgejo/o/r/pulls/1"}, []byte(`{"costUsd":0.40}`), nil)); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.EvaluateItem(ctx, id); err != nil {
+		t.Fatal(err)
+	}
+	runRound(t, e, id, "reviewer", work.OutcomeNoChangeNeeded, harness.VerdictRequestChanges)
+	shiftID := mustShift(t, id)
+	before, err := testStore.Ledger(ctx, shiftID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if before.Spent <= 0 {
+		t.Fatal("the initial writer's spend was not settled")
+	}
+	runRound(t, e, id, "builder", work.OutcomePRUpdated, "")
+	runRound(t, e, id, "reviewer", work.OutcomeNoChangeNeeded, "")
+	if got := closeReason(t, id); got != "review_incomplete" {
+		t.Errorf("close reason = %q, want review_incomplete", got)
+	}
+	after, err := testStore.Ledger(ctx, shiftID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if before.Budget != after.Budget || after.Spent < before.Spent {
+		t.Errorf("fix pair reset its budget or spend: before=%+v after=%+v", before, after)
+	}
+	var rounds, runs int
+	if err := testPool.QueryRow(ctx, `SELECT max(round), count(*) FROM agent_runs WHERE shift_id = $1`, shiftID).Scan(&rounds, &runs); err != nil {
+		t.Fatal(err)
+	}
+	if rounds != 4 || runs != 4 {
