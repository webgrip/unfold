@@ -0,0 +1,165 @@
+package httpapi
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"testing/iotest"
+)
+
+const rawReviewPayload = `{ "repository": { "full_name": "webgrip/ploeg" }, "pull_request": { "number": 7 }, "review": { "type": "pull_request_review_rejected", "content": "Re-check café ☕" } }`
+
+func forgeRawRequest(secret, delivery, body string) *http.Request {
+	req := httptest.NewRequest(http.MethodPost, "/webhooks/forge/forgejo", strings.NewReader(body))
+	req.Header.Set("Content-Type", "application/json; charset=utf-8")
+	req.Header.Set("X-Forgejo-Event", "pull_request_review")
+	req.Header.Set("X-Forgejo-Delivery", delivery)
+	mac := hmac.New(sha256.New, []byte(secret))
+	_, _ = mac.Write([]byte(body))
+	req.Header.Set("X-Forgejo-Signature", hex.EncodeToString(mac.Sum(nil)))
+	return req
+}
+
+func forgeDeliveriesFor(t *testing.T, delivery string) int {
+	t.Helper()
+	var n int
+	if err := testPool.QueryRow(context.Background(),
+		`SELECT count(*) FROM forge_deliveries WHERE provider = 'forgejo' AND delivery_id = $1`, delivery).Scan(&n); err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestForgeWebhook_InvalidRequestsCannotReserveDelivery(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		change func(*http.Request) *http.Request
+		want   int
+	}{
+		{
+			name: "wrong signature",
+			change: func(r *http.Request) *http.Request {
+				r.Header.Set("X-Forgejo-Signature", strings.Repeat("0", 64))
+				return r
+			},
+			want: http.StatusBadRequest,
+		},
+		{
+			name: "missing signature",
+			change: func(r *http.Request) *http.Request {
+				r.Header.Del("X-Forgejo-Signature")
+				return r
+			},
+			want: http.StatusBadRequest,
+		},
+		{
+			name: "unsupported signature algorithm",
+			change: func(r *http.Request) *http.Request {
+				r.Header.Set("X-Forgejo-Signature", strings.Repeat("0", 40))
+				return r
+			},
+			want: http.StatusBadRequest,
+		},
+		{
+			name: "authenticated malformed JSON",
+			change: func(r *http.Request) *http.Request {
+				return forgeRawRequest("shh", r.Header.Get("X-Forgejo-Delivery"), `{"repository":`)
+			},
+			want: http.StatusBadRequest,
+		},
+		{
+			name: "body read failure",
+			change: func(r *http.Request) *http.Request {
+				r.Body = io.NopCloser(iotest.ErrReader(errors.New("fixture read failed")))
+				return r
+			},
+			want: http.StatusBadRequest,
+		},
+		{
+			name: "oversized declared length",
+			change: func(r *http.Request) *http.Request {
+				return forgeRawRequest("shh", r.Header.Get("X-Forgejo-Delivery"), rawReviewPayload+strings.Repeat(" ", maxForgeWebhookBytes))
+			},
+			want: http.StatusRequestEntityTooLarge,
+		},
+		{
+			name: "oversized unknown length",
+			change: func(r *http.Request) *http.Request {
+				r = forgeRawRequest("shh", r.Header.Get("X-Forgejo-Delivery"), rawReviewPayload+strings.Repeat(" ", maxForgeWebhookBytes))
+				r.ContentLength = -1
+				return r
+			},
+			want: http.StatusRequestEntityTooLarge,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			h := forgeServer(t, "shh")
+			delivery := t.Name()
+			rec := httptest.NewRecorder()
+			h.ServeHTTP(rec, tc.change(forgeRawRequest("shh", delivery, rawReviewPayload)))
+			if rec.Code != tc.want {
+				t.Fatalf("invalid request returned %d, want %d", rec.Code, tc.want)
+			}
+			if n := forgeDeliveriesFor(t, delivery); n != 0 {
+				t.Fatalf("rejected request reserved %d delivery IDs", n)
+			}
+			if n := forgeAuditCount(t); n != 0 {
+				t.Fatalf("rejected request recorded %d audit rows", n)
+			}
+			for attempt := 0; attempt < 2; attempt++ {
+				rec = httptest.NewRecorder()
+				h.ServeHTTP(rec, forgeRawRequest("shh", delivery, rawReviewPayload))
+				if rec.Code != http.StatusAccepted {
+					t.Fatalf("valid delivery %d returned %d", attempt, rec.Code)
+				}
+			}
+			if n := forgeDeliveriesFor(t, delivery); n != 1 {
+				t.Errorf("valid deliveries reserved %d delivery IDs, want 1", n)
+			}
+			if n := forgeAuditCount(t); n != 1 {
+				t.Errorf("valid deliveries recorded %d audit rows, want 1", n)
+			}
+		})
+	}
+}
+
+func TestForgeWebhook_RedeliveryStillAuthenticatesRawBody(t *testing.T) {
+	h := forgeServer(t, "shh")
+	delivery := t.Name()
+	body := "\n\t" + rawReviewPayload + "\n"
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, forgeRawRequest("shh", delivery, body))
+	if rec.Code != http.StatusAccepted {
+		t.Fatalf("valid whitespace-preserving delivery returned %d", rec.Code)
+	}
+	changed := forgeRawRequest("shh", delivery, body+" ")
+	changed.Header.Set("X-Forgejo-Signature", forgeRawRequest("shh", delivery, body).Header.Get("X-Forgejo-Signature"))
+	rec = httptest.NewRecorder()
+	h.ServeHTTP(rec, changed)
+	if rec.Code != http.StatusBadRequest {
+		t.Fatalf("altered raw body reused known delivery ID and returned %d, want 400", rec.Code)
+	}
+	if n := forgeAuditCount(t); n != 1 {
+		t.Errorf("audit rows = %d, want only the authentic event", n)
+	}
+}
+
+func TestForgeWebhook_AcceptsPayloadAtSizeLimit(t *testing.T) {
+	h := forgeServer(t, "shh")
+	body := rawReviewPayload + strings.Repeat(" ", maxForgeWebhookBytes-len(rawReviewPayload))
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, forgeRawRequest("shh", t.Name(), body))
+	if rec.Code != http.StatusAccepted {
+		t.Fatalf("exactly %d raw bytes returned %d, want 202", len(body), rec.Code)
+	}
+	if n := forgeAuditCount(t); n != 1 {
+		t.Errorf("audit rows = %d, want 1", n)
+	}
+}
