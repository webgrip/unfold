+	rec := httptest.NewRecorder()
+	s.Handler().ServeHTTP(rec, httptest.NewRequest(http.MethodPost, "/webhooks/tracker/test-tracker", strings.NewReader("{}")))
+	if rec.Code != http.StatusConflict {
