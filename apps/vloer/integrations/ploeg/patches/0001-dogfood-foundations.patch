+	return p.events, nil
+}
+
+func TestMirror_ConflictingEventScopeIsRejectedBeforeRoutingAndIngest(t *testing.T) {
+	s := testServer(t, "old/docs=client-old/old-project@main,current/app=client-current/application@development")
+	s.ScopeTeams = map[string]string{"old": "docs", "current": "app"}
