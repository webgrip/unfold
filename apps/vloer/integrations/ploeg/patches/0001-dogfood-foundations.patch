+	runRound(t, e, id, "reviewer", work.OutcomeNoChangeNeeded, "")
+	if err := e.EvaluateItem(ctx, id); err != nil {
+		t.Fatal(err)
+	}
+	if len(tracker.comments) != 1 {
+		t.Fatalf("tracker comments = %d, want one durable handoff", len(tracker.comments))
+	}
+	body := tracker.comments[0]
+	for _, want := range []string{"approval is incomplete", "opened a pull request", "required checks and approvals pass", "stays open until it is in production"} {
+		if !strings.Contains(body, want) {
+			t.Errorf("handoff missing %q: %s", want, body)
+		}
+	}
+	if strings.Contains(body, "finished this item") || strings.Contains(body, "reviewer approved") {
+		t.Errorf("handoff claims completion or approval: %s", body)
+	}
+	if len(tracker.statuses) != 1 || tracker.statuses[0] != work.StateNeedsHuman {
+		t.Errorf("tracker statuses = %v, want needs_human", tracker.statuses)
+	}
