+		{"missing required Role", []store.RunReport{approve("reviewer")}, 2, "review_incomplete", false},
+		{"unexpected Role cannot substitute", []store.RunReport{approve("reviewer"), approve("analyst")}, 2, "review_incomplete", false},
+		{"no verdict", []store.RunReport{approve("reviewer"), report("security", "", "no_change_needed", 2, false)}, 2, "review_incomplete", false},
+		{"malformed verdict", []store.RunReport{approve("reviewer"), report("security", "approve ", "no_change_needed", 2, false)}, 2, "review_incomplete", false},
+		{"inconclusive verdict", []store.RunReport{approve("reviewer"), report("security", "inconclusive", "no_change_needed", 2, false)}, 2, "review_incomplete", false},
+		{"failed reviewer with approval", []store.RunReport{approve("reviewer"), report("security", "approve", "failed", 2, false)}, 2, "review_incomplete", false},
+		{"stuck reviewer with approval", []store.RunReport{approve("reviewer"), report("security", "approve", "stuck", 2, false)}, 2, "review_incomplete", false},
