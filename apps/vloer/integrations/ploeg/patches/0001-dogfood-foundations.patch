+func allReviewersApprove(reports []store.RunReport, round int, roles []plan.Role) bool {
+	if len(roles) == 0 {
+		return false
+	}
+	for _, role := range roles {
+		if role.Writes {
+			return false
+		}
+		approved := false
+		for _, report := range reports {
+			if report.Round != round || report.Role != role.Name || report.Writes {
+				continue
+			}
+			outcome := work.Outcome(report.Outcome)
+			if !outcome.Valid() || work.StateForOutcome(outcome) != work.StateDone || report.Verdict != harness.VerdictApprove {
+				return false
+			}
+			approved = true
+		}
+		if !approved {
+			return false
+		}
+	}
+	return true
+}
