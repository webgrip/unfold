@@ -0,0 +1,28 @@
+package httpapi
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+)
+
+const maxForgeWebhookBytes = 1 << 20
+
+func prepareForgeWebhook(w http.ResponseWriter, r *http.Request) bool {
+	if r.ContentLength > maxForgeWebhookBytes {
+		http.Error(w, "webhook payload too large", http.StatusRequestEntityTooLarge)
+		return false
+	}
+	defer r.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(r.Body, maxForgeWebhookBytes+1))
+	if err != nil {
+		http.Error(w, "webhook body could not be read", http.StatusBadRequest)
+		return false
+	}
+	if len(body) > maxForgeWebhookBytes {
+		http.Error(w, "webhook payload too large", http.StatusRequestEntityTooLarge)
+		return false
+	}
+	r.Body = io.NopCloser(bytes.NewReader(body))
+	return true
+}
