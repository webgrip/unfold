+	report := func(role, verdict, outcome string, round int, writes bool) store.RunReport {
+		return store.RunReport{Role: role, Round: round, Writes: writes, Verdict: verdict, Outcome: outcome}
+	}
+	approve := func(role string) store.RunReport {
