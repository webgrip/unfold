+func TestMirror_ThinClickUpWebhookRoutesUsingFetchedList(t *testing.T) {
+	api := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet || r.URL.Path != "/task/86abc" {
+			t.Errorf("unexpected ClickUp request: %s %s", r.Method, r.URL.Path)
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		if r.Header.Get("Authorization") != "pk_test" {
+			t.Error("ClickUp task fetch did not use configured credentials")
+			w.WriteHeader(http.StatusUnauthorized)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"id":"86abc","name":"Fix routing","date_updated":"1770000000000","list":{"id":"901","name":"Client App"}}`))
+	}))
+	defer api.Close()
+
+	tp := &clickup.Provider{
+		Secret: "webhook-secret", BaseURL: api.URL, Token: "pk_test",
+		DefaultTeam: "docs", TeamMap: map[string]string{"builder": "infra"},
+	}
+	body := `{"event":"taskAssigneeUpdated","task_id":"86abc","history_items":[{"field":"assignee_add","after":{"username":"builder"}}]}`
+	req := httptest.NewRequest(http.MethodPost, "/webhooks/tracker/clickup", strings.NewReader(body))
+	mac := hmac.New(sha256.New, []byte(tp.Secret))
+	_, _ = mac.Write([]byte(body))
+	req.Header.Set("X-Signature", hex.EncodeToString(mac.Sum(nil)))
+	events, err := tp.ParseWebhook(req)
+	if err != nil || len(events) != 1 {
+		t.Fatalf("parse signed ClickUp assignment: events=%d err=%v", len(events), err)
+	}
+	ev := events[0]
+	if ev.Scope.ID != "" || ev.Team != "infra" {
+		t.Fatalf("unexpected thin event: %+v", ev)
+	}
+	s := testServer(t, "901/app=client-one/application@development")
+	s.ScopeTeams = map[string]string{"901": "app"}
+	item, err := s.mirror(context.Background(), tp, ev)
+	if err != nil {
+		t.Fatalf("mirror ClickUp task: %v", err)
+	}
+	s.pinTeam(&item)
+	s.resolveTarget(&item, ev)
+
+	if item.ExternalScope != "901" || item.Team != "app" {
+		t.Fatalf("fetched List did not drive team routing: scope=%q team=%q", item.ExternalScope, item.Team)
+	}
+	if item.Target == nil || item.Target.Owner != "client-one" || item.Target.Repo != "application" || item.Target.BaseBranch != "development" {
+		t.Fatalf("fetched List did not drive repository routing: %+v", item.Target)
+	}
+	if item.RouteRule != "901/app" || item.Title != "Fix routing" || item.Revision != "1770000000000" {
+		t.Fatalf("authoritative content or routing evidence lost: %+v", item)
+	}
+}
+
+type mirrorTracker struct {
+	provider.TrackerProvider
