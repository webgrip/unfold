+func TestLoop_IncompleteReviewHandoffDoesNotClaimCompletion(t *testing.T) {
+	ctx := context.Background()
+	e := loopEngine(t, 10, 2)
+	tracker := &fakeTracker{}
+	e.Trackers = map[string]provider.TrackerProvider{"vikunja": tracker}
+	id := startLoopShift(t, e, "983")
