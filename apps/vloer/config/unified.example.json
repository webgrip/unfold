{
  "mode": "live",
  "host": "127.0.0.1",
  "port": 4080,
  "dataDir": ".vloer/unified",
  "runtime": {
    "kind": "opencode",
    "backends": [
      "docker"
    ],
    "binary": "opencode",
    "timeoutMs": 3600000,
    "agentEnvironment": []
  },
  "maxConcurrentSessions": 1,
  "maxBudgetUsd": 1,
  "models": [
    {
      "id": "coding",
      "name": "Configured coding model",
      "providerId": "gateway",
      "modelId": "replace-with-your-litellm-model-alias"
    }
  ],
  "repositories": [
    {
      "id": "application",
      "name": "Application",
      "description": "Operator-approved repository",
      "url": "https://forge.example/organization/application.git",
      "baseBranch": "main",
      "verify": [
        "node",
        "--test"
      ],
      "executionOwner": "ploeg"
    }
  ],
  "litellm": {
    "baseUrl": "https://gateway.internal.example/v1"
  },
  "docker": {
    "image": "de-vloer-agent:1.18.30",
    "cpus": 2,
    "memoryMb": 4096,
    "pidsLimit": 512
  },
  "ploeg": {
    "url": "https://ploeg.internal.example",
    "tokenEnv": "PLOEG_OPERATOR_VLOER_TOKEN",
    "teams": [
      "delivery"
    ],
    "userTeams": {
      "replace-with-user-id": [
        "delivery"
      ]
    }
  },
  "execution": {
    "team": "delivery",
    "heartbeatMs": 15000
  }
}
