{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ploeg chart values",
  "type": "object",
  "properties": {
    "executor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "enum": ["keda", "cronjob"] },
        "harness": { "$ref": "#/definitions/harness" },
        "runnerImage": { "type": "string" },
        "dindImage": { "type": "string" },
        "workerImage": { "type": "string" },
        "apiUrl": { "type": "string" },
        "cronjob": {
          "type": "object",
          "properties": { "schedule": { "type": "string", "minLength": 1 } }
        },
        "defaultTarget": {
          "type": "object",
          "description": "fallback repo for teams that declare none; empty = a team with no repoOwner/repoName gets no env target and relies entirely on the work item's resolved target",
          "properties": {
            "owner": { "type": "string" },
            "name": { "type": "string" },
            "baseBranch": { "type": "string" }
          },
          "additionalProperties": false
        },
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$" },
              "model": { "type": "string", "minLength": 1 },
              "budget": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
              "repoOwner": { "type": "string", "minLength": 1 },
              "repoName": { "type": "string", "minLength": 1 },
              "baseBranch": { "type": "string" },
              "targetSource": { "enum": ["claim", "env"] },
              "maxReplicaCount": { "type": "integer", "minimum": 1 },
              "harness": { "$ref": "#/definitions/harness" }
            },
            "//": "repoOwner/repoName are NOT required: the repository belongs to the work item, resolved at ingest (R11). They remain as a per-team fallback while teams migrate.",
            "required": ["name", "model", "budget"],
            "additionalProperties": false
          }
        }
      }
    }
  },
  "definitions": {
    "harness": {
      "type": "object",
      "properties": {
        "name": { "enum": ["openhands", "exec", "claude-code", "acp"] },
        "image": { "type": "string" },
        "entrypoint": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "outcomeFile": { "type": "string" },
        "dind": { "type": "boolean" },
        "acp": { "$ref": "#/definitions/acp" }
      },
      "additionalProperties": false
    },
    "acp": {
      "type": "object",
      "properties": {
        "profile": { "enum": ["opencode", "custom"] },
        "argv": { "type": "array", "items": { "type": "string" } },
        "permissionMode": { "enum": ["", "allow_always", "allow_read_only", "deny_all"] },
        "promptTimeout": { "type": "string", "pattern": "^$|^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$" },
        "idleTimeout": { "type": "string", "pattern": "^$|^[0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h)$" },
        "configJson": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
